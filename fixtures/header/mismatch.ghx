                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  #region Properties and Fields
  private BoundingBox _clippingBox;
  System.Drawing.Color _col = System.Drawing.Color.Aquamarine;
  System.Drawing.Color _colCross = System.Drawing.Color.CornflowerBlue;
  System.Drawing.Color _colGolden = System.Drawing.Color.DarkGoldenrod;
  System.Drawing.Color _colPersp = System.Drawing.Color.Aqua;
  System.Drawing.Color _colPerspAuto = System.Drawing.Color.Coral;
  Single _thickness = 3;
  bool _drawCrosshairs;
  bool _drawThirds;
  bool _drawSpiral;
  bool _flipSpiral;
  int _spiralCP = 20;
  bool _drawHorizon; Line _horizonLine = Line.Unset;
  bool _drawGoldenGrid;
  double _vertPercent = -1;
  double _onePtPersp = -1;
  bool _autoPersp; Line _vertLine = Line.Unset;
  #endregion Properties and Fields

  public override BoundingBox ClippingBox { get { return BoundingBox.Empty; } } //Return a BoundingBox that contains all the geometry you are about to draw.
  public override void DrawViewportMeshes(IGH_PreviewArgs args) { } //Draw all meshes in this method.

  //Draw all wires and points in this method. Access to the current Viewport (no reload required)
  public override void DrawViewportWires(IGH_PreviewArgs args)
  {
    #region Crosshairs
    if (_drawCrosshairs)
    {
      args.Display.EnableDepthTesting(false); //keep in front
      args.Display.EnableDepthWriting(true); //keep in front
      int width = args.Viewport.Bounds.Width; int height = args.Viewport.Bounds.Height;


      Point3d frustrumCenter; args.Viewport.GetFrustumCenter(out frustrumCenter); // eucledian in front cam canter
      Point2d clientPoint = args.Viewport.WorldToClient(frustrumCenter); // screen values
      Line pointRay = args.Viewport.ClientToWorld(clientPoint); // connecting points
      Plane nearPlane; args.Viewport.GetFrustumNearPlane(out nearPlane); // in front cam plane
      double t; Rhino.Geometry.Intersect.Intersection.LinePlane(pointRay, nearPlane, out t); // cam to target
      Point3d point = pointRay.PointAt(t - 0.01); // ensure clipping works

      double pixelsPerUnit; args.Viewport.GetWorldToScreenScale(point, out pixelsPerUnit); // eucledian to cam distance
      double radius = 300 / pixelsPerUnit; // prevent cam distance scaling

      //      args.Display.DrawCircle(new Circle(nearPlane, 10), _colCross, 4); // scaling center circle
      args.Display.DrawCircle(new Circle(point, radius * 0.3), _colCross, 4); // worldplane center circle
      nearPlane.Origin = point; // move near plane to visible area (towards target)
      args.Display.DrawCircle(new Circle(nearPlane, radius), _colCross, 4); // static center circle

      args.Display.DrawPoint(point, Rhino.Display.PointStyle.X, 4, _colCross);
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) (width * 0.15), (int) (height / 2)),
        new System.Drawing.Point((int) (width / 2 - width / 2 * 0.15), (int) (height / 2)), _colCross, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) (width - width * 0.15), (int) (height / 2)),
        new System.Drawing.Point((int) (width / 2 + width / 2 * 0.15), (int) (height / 2)), _colCross, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) (width / 2), (int) (height * 0.02)),
        new System.Drawing.Point((int) (width / 2), (int) (height / 2 - width / 2 * 0.15)), _colCross, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) (width / 2), (int) (height - height * 0.02)),
        new System.Drawing.Point((int) (width / 2), (int) (height / 2 + width / 2 * 0.15)), _colCross, _thickness);
      /*//Draw on target position in worldplane
      Point3d center = Point3d.Unset; args.Viewport.GetFrustumCenter(out center);
      _clippingBox.Union(center);
      args.Display.DrawCircle(new Circle(100), System.Drawing.Color.LawnGreen, 2); */
    }
    #endregion Crosshairs
    #region Thirds
    if (_drawThirds) // Rule of Thirds (screen)
    {
      args.Display.EnableDepthTesting(false); //keep in front
      args.Display.EnableDepthWriting(true); //keep in front
      int width = args.Viewport.Bounds.Width;
      int height = args.Viewport.Bounds.Height;
      args.Display.Draw2dLine(new System.Drawing.Point(0, height / 3),
        new System.Drawing.Point(width, height / 3), _col, _thickness);
      args.Display.Draw2dLine(new System.Drawing.Point(0, height / 3 * 2),
        new System.Drawing.Point(width, height / 3 * 2), _col, _thickness);
      args.Display.Draw2dLine(new System.Drawing.Point(width / 3, 0),
        new System.Drawing.Point(width / 3, height), _col, _thickness);
      args.Display.Draw2dLine(new System.Drawing.Point(width / 3 * 2, 0),
        new System.Drawing.Point(width / 3 * 2, height), _col, _thickness);
    }
    #endregion Thirds
    #region Golden Spiral
    if (_drawSpiral) // Draw GoldenSpiral curve in 2D (cartesian) //TODO: change pos and orient option feature
    {
      args.Display.EnableDepthTesting(false); //keep in front
      args.Display.EnableDepthWriting(true); //keep in front
      Plane plane; args.Viewport.GetFrustumNearPlane(out plane); //visilbe plane close to cam
      Point3d[] nearRectPts = args.Viewport.GetNearRect(); //corner points of near plane visible rectangle
      Point3d buttomLeft = nearRectPts[0]; //origin for new plane and scaling
      Point3d topLeft = nearRectPts[2]; //Zigzag order
      plane.Origin = buttomLeft; //rebase planePoint3d topRight = nearRectPts[3]; //Zigzag order
      //      var curve = GoldenSpiral(buttomLeft.DistanceTo(topLeft), _spiralCP);
      var curve = GoldenSpiral(new Point3d(0, 0, 0), buttomLeft.DistanceTo(topLeft), _spiralCP, !_flipSpiral);

      curve.Transform(Transform.PlaneToPlane(Plane.WorldXY, plane)); //orient geometry
      args.Display.DrawCurve(curve, _colGolden, (int) _thickness);
    }
    #endregion Golden Spiral
    #region Phi Grid
    if(_drawGoldenGrid) // Phi Grid overlay
    {
      args.Display.EnableDepthTesting(false); //keep in front
      args.Display.EnableDepthWriting(true); //keep in front
      double phi = (1 + Math.Sqrt(5)) / 2;
      int width = args.Viewport.Bounds.Width;
      int height = args.Viewport.Bounds.Height;
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) Math.Round(width - (width * phi - width), 0), 0),
        new System.Drawing.Point((int) Math.Round(width - (width * phi - width), 0), height),
        _colGolden, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point((int) Math.Round(width * phi - width, 0), 0),
        new System.Drawing.Point((int) Math.Round(width * phi - width, 0), height),
        _colGolden, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point(0, (int) Math.Round(height - (height * phi - height), 0)),
        new System.Drawing.Point(width, (int) Math.Round(height - (height * phi - height), 0)),
        _colGolden, _thickness);
      args.Display.Draw2dLine(
        new System.Drawing.Point(0, (int) Math.Round(height * phi - height, 0)),
        new System.Drawing.Point(width, (int) Math.Round(height * phi - height, 0)),
        _colGolden, _thickness);
    }
    #endregion Phi Grid
    #region Horizon line
    if (_drawHorizon) // Horizon line, effects and percentages
    {
      var pts = args.Viewport.GetNearRect();
      Curve lLeft = (new Line(pts[0], pts[2])).ToNurbsCurve();
      Curve lRight = (new Line(pts[1], pts[3])).ToNurbsCurve();
      Plane plane = new Plane(args.Viewport.CameraLocation, Vector3d.XAxis, Vector3d.YAxis);
      Rhino.Geometry.Intersect.CurveIntersections left =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lLeft, plane, 0.001);
      Rhino.Geometry.Intersect.CurveIntersections right =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lRight, plane, 0.001);
      if (left == null) return; //disable if horizon not visible
      Point3d ptL = left[0].PointA;
      Point3d ptR = right[0].PointA;
      args.Display.EnableDepthTesting(false); //make sure it's in front (if pts found)
      args.Display.EnableDepthWriting(true);
      double length = lLeft.PointAt(0).DistanceTo(ptL); //get distances to thirds
      _vertPercent = 1 - (length / lLeft.GetLength());
      double _diffUp = Math.Round(Math.Abs(length - (lLeft.GetLength() / 3 * 2)), 1);
      double _diffDown = Math.Round(Math.Abs(length - (lLeft.GetLength() / 3)), 1);
      System.Drawing.Color col; int size = (int) _thickness; int sizeUp = size; int sizeDown = size; //init
      double threshold = length / (6 * 12);
      if (_diffUp &lt; threshold || _diffDown &lt; threshold) //mark if close (effect)
      {
        col = System.Drawing.Color.DarkOrange;
        size = 5;
        if (_diffUp &lt; threshold) sizeUp = 5;
        else sizeDown = 5;
      }
      else //revert back
      {
        col = _col; sizeUp = sizeDown = size = (int) _thickness;
      }
      args.Display.DrawLine(ptL, ptR, col, size);
      _horizonLine = new Line(ptL, ptR);
      args.Display.Draw2dText("diffUp: " + Math.Round(_diffUp / lLeft.GetLength() * 100, 0) + "%", col,
        new Point2d(args.Viewport.Bounds.Width * 0.15, args.Viewport.Bounds.Height / 3 + sizeUp * 5 + 2),
        true, sizeUp * 5);
      args.Display.Draw2dText("diffDown: " + Math.Round(_diffDown / lLeft.GetLength() * 100, 0) + "%", col,
        new Point2d(args.Viewport.Bounds.Width * 0.15, args.Viewport.Bounds.Height * 2 / 3 + sizeDown * 5 + 2),
        true, sizeDown * 5);
      //showcase ground level human heights
      double camHeight = args.Viewport.CameraLocation.Z;
      string position = "";
      if (camHeight &lt;= 1.90 &amp;&amp; camHeight &gt;= 1.60) position = "Human standing position";
      if (camHeight &lt;= 1.60 &amp;&amp; camHeight &gt;= 1.40) position = "Human sitting position";
      if (!string.IsNullOrEmpty(position))
        args.Display.Draw2dText(position, System.Drawing.Color.DarkOrange,
          new Point2d(args.Viewport.Bounds.Width * 0.15, args.Viewport.Bounds.Height - 15), true, sizeDown * 5);
    }
    #endregion  Horizon line
    #region One point perspective
    if (_drawHorizon &amp;&amp; _onePtPersp &gt;= 0.0001) // One point perspective lines
    {
      NurbsCurve curve = _horizonLine.ToNurbsCurve();
      curve.Domain = new Interval(0, 1);
      int height = args.Viewport.Bounds.Height; //use display values
      int width = args.Viewport.Bounds.Width;
      int vert = (int) Math.Round(height * _vertPercent, 0);
      int hor = (int) Math.Round(width * _onePtPersp, 0);
      System.Drawing.Point center = new System.Drawing.Point(hor, vert);
      var pts = new System.Drawing.Point[]{
        new System.Drawing.Point(0, height),
        new System.Drawing.Point(0, 0),
        new System.Drawing.Point(width, 0),
        new System.Drawing.Point(width, height)};
      args.Display.EnableDepthTesting(false); //make sure it's in front
      args.Display.EnableDepthWriting(true);
      foreach (var pt in pts)
        args.Display.Draw2dLine(pt, center, _colPersp, _thickness);
    }
    if (_drawHorizon &amp;&amp; _autoPersp) // One point perspective lines
    {
      /*
      var pts = args.Viewport.GetNearRect();
      Curve lTop = (new Line(pts[0], pts[1])).ToNurbsCurve();
      Curve lButtom = (new Line(pts[2], pts[3])).ToNurbsCurve();
 */
      Plane planeXZ = new Plane(args.Viewport.CameraLocation, Vector3d.XAxis, Vector3d.ZAxis); //XZ
      Plane planeYZ = new Plane(args.Viewport.CameraLocation, Vector3d.YAxis, Vector3d.ZAxis); //YZ

      NurbsCurve curve = _vertLine.ToNurbsCurve();
      Rhino.Geometry.Intersect.CurveIntersections horXZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(curve, planeXZ, 0.001);
      Rhino.Geometry.Intersect.CurveIntersections horYZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(curve, planeYZ, 0.001);

      /*
      Rhino.Geometry.Intersect.CurveIntersections topXZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lTop, planeXZ, 0.001);
      Rhino.Geometry.Intersect.CurveIntersections buttonXZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lButtom, planeXZ, 0.001);
      Rhino.Geometry.Intersect.CurveIntersections topYZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lTop, planeYZ, 0.001);
      Rhino.Geometry.Intersect.CurveIntersections buttonYZ =
        Rhino.Geometry.Intersect.Intersection.CurvePlane(lButtom, planeYZ, 0.001);
   */
      Point3d center = Point3d.Unset;
      Point3d ptT = Point3d.Unset; Point3d ptB = ptT; // solve only one point (for now)
      //      if (topXZ != null)
      if (horXZ != null)
      {
        center = horXZ[0].PointA;
        /*
        ptT = topXZ[0].PointA;
        ptB = buttonXZ[0].PointA;
        _vertLine = new Line(ptT, ptB); // solve only one point
 */
      }
      else if (horYZ != null)
        //      else if (topYZ != null) // solve only one point
      {
        center = horYZ[0].PointA;
        /*
        ptT = topYZ[0].PointA;
        ptB = buttonYZ[0].PointA;
        _vertLine = new Line(ptT, ptB);
 */
      }
      else return;


      curve.Domain = new Interval(0, 1);
      int height = args.Viewport.Bounds.Height; //use display values
      int width = args.Viewport.Bounds.Width;
      double horPercent; curve.ClosestPoint(center, out horPercent);
      //1 - (height / lButtom.GetLength());
      int vert = (int) Math.Round(height * _vertPercent, 0);
      int hor = (int) Math.Round(width * horPercent, 0);
      //System.Drawing.Point center = new System.Drawing.Point(hor, vert);
      var ptsPersp = new System.Drawing.Point[]{
        new System.Drawing.Point(0, height),
        new System.Drawing.Point(0, 0),
        new System.Drawing.Point(width, 0),
        new System.Drawing.Point(width, height)};
      args.Display.EnableDepthTesting(false); //make sure it's in front
      args.Display.EnableDepthWriting(true);
      foreach (var pt in ptsPersp)
        args.Display.Draw2dLine(
          pt,
          new System.Drawing.Point((int) Math.Round(center.X, 0), (int) Math.Round(center.Y, 0)),
          _colPerspAuto,
          _thickness);
    }
    #endregion  One point perspective
  }

  #region Spirals
  private NurbsCurve GoldenSpiral(double height, int controlPointAmount)
  {
    double phi = (1 + Math.Sqrt(5)) / 2; // Golden ratio variable
    Point3d[] controlPoints = new Point3d[controlPointAmount]; // Control points (CPs) list for the nurbs curve
    int points = controlPointAmount; // Input controlling number of loop-iterations
    double x = 0, y = 0; double d = height; // Initial y and distance is height (screen direction top-to-button)
    string direction = "up"; // Initial direction is down
    for (int i = 0; i &lt; points; i++) // Loop to add CPs based on the rules
    {
      //if(i == 0 || i % 2 == 1) //smoother***
      {
        //Print(new Point3d(Math.Round(x, 2), Math.Round(y, 2), 0).ToString()); //feedback##
        controlPoints[i] = new Point3d(x, y, 0); // Add the control point to the list
      }
      switch (direction) // X, y value update based on the direction
      {
        case "down": y -= d; break; // Direction changes every 2 CPs up, right, down, left, ...*
        case "right": x += d; break;
        case "up": y += d; break;
        case "left": x -= d; break;
      }
      if (i % 2 == 0)
        switch (direction) // Direction-change update every two CP* (even)
        {
          case "up": direction = "right"; break;
          case "right": direction = "down"; break;
          case "down": direction = "left"; break;
          case "left": direction = "up"; break;
        }
      if (i % 2 == 1) d = phi * d - d; // Distance update every other two CP (odd)
    }
    NurbsCurve curve = NurbsCurve.Create(false, 3, controlPoints);// .CreateInterpolatedCurve(controlPoints, 3); //smoother***
    return curve;
  }

  private Curve GoldenSpiral(Point3d origin, double height, int numberOfPoints, bool clockwise)
  {
    // Define input parameters
    Point3d basePoint = new Point3d(1, 1, 0); // Set your base point
    if (Component.Params.Input[1].VolatileDataCount &lt; 1) numberOfPoints = 4; // Set the number of points

    List&lt;Curve&gt; arcsList = new List&lt;Curve&gt;();
    double phi = (1 + Math.Sqrt(5)) / 2;
    double distance = clockwise ? height : height * phi - height;
    Point3d[] ScaledTrPoints = new Point3d[numberOfPoints + 1];
    ScaledTrPoints[0] = origin;
    Arc[] arcs = new Arc[numberOfPoints];

    // Convert the base point to a Grasshopper Complex number
    Grasshopper.Kernel.Types.Complex z = new Grasshopper.Kernel.Types.Complex(basePoint.X, basePoint.Y);

    Vector3d vec; //Point3dorientationPt = new Point3d(-1, 1, 0);
    for (int i = 0; i &lt; numberOfPoints; i++)
    {
      if (i % 2 == 0) vec = clockwise ? new Vector3d(0, z.Imaginary, 0) : new Vector3d(z.Real, 0, 0);
      else vec = clockwise ? new Vector3d(z.Real, 0, 0) : new Vector3d(0, z.Imaginary, 0);

      ScaledTrPoints[i + 1] = new Point3d(
        z.Real * distance + ScaledTrPoints[i].X,
        z.Imaginary * distance + ScaledTrPoints[i].Y
        , 0);// Add the rotated point to the result array

      arcs[i] = new Arc(ScaledTrPoints[i], vec, ScaledTrPoints[i + 1]);
      arcsList.Add(NurbsCurve.CreateFromArc(arcs[i]));

      if (clockwise) z /= new Grasshopper.Kernel.Types.Complex(0, 1); // Divide z by i (rotate complex number 90°)
      else z *= new Grasshopper.Kernel.Types.Complex(0, 1); // Multiply z by i (rotate complex number -90°)

      distance = phi * distance - distance;
    }

    return NurbsCurve.JoinCurves(arcsList)[0];
  }
  #endregion

  /// &lt;summary&gt;
  /// This method will be called once every solution, before any calls to RunScript.
  /// &lt;/summary&gt;
  public override void BeforeRunScript()
  { _clippingBox = BoundingBox.Empty; }
  /// &lt;summary&gt;
  /// This method will be called once every solution, after any calls to RunScript.
  /// &lt;/summary&gt;
  public override void AfterRunScript()
  { }
</item>
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>99</X>
                      <Y>164</Y>
                    </item>
                    <item name="IconDisplay" type_name="gh_int32" type_code="3">1</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">4d7cae65-623e-451d-9f03-2d32e83d2ee4</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Compose</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    var pt = doc.Views.ActiveView.ActiveViewport.CameraLocation;
    if (Stand)
      doc.Views.ActiveView.ActiveViewport.SetCameraLocation(new Point3d(pt.X, pt.Y, 1.80), false);
    if (Sit)
      doc.Views.ActiveView.ActiveViewport.SetCameraLocation(new Point3d(pt.X, pt.Y, 1.50), false);

    _onePtPersp = -1;
    _horizonLine = Line.Unset;

    #region Inputs
    _drawCrosshairs = Crosshairs;
    _drawThirds = Thirds;
    _drawSpiral = Spiral;
    _flipSpiral = flipSpiral;
    _drawHorizon = Horizon;
    _drawGoldenGrid = GoldenGrid;
    _autoPersp = AutoPersp;
    if (Component.Params.Input.Find(x =&gt; x.NickName == "OnePtPersp").VolatileDataCount &gt;= 1)
      _onePtPersp = OnePtPersp;
    #endregion Inputs

    A = _horizonLine; //_vertPercent;
    B = _vertLine; //_onePtPersp;

    #region Cosmetics
    Component.Params.Input.Find(x =&gt; x.NickName == "Spiral")
      .Description = "use the golden ratio, which is a similar technique that uses a grid of rectangles instead of squares" +
      ", creating a spiral pattern that guides the eye to the center of the image.";
    Component.Params.Input.Find(x =&gt; x.NickName == "Thirds")
      .Description = "Place the main elements or focal points of your scene along the lines or at their intersections" +
      ", creating a balance and harmony in the image.";
    Component.Params.Input.Find(x =&gt; x.NickName == "OnePtPersp")
      .Description = "One-point perspective creates a sense of depth and direction" +
      ", as all the parallel lines converge to a single vanishing point on the horizon line.";
    #endregion Cosmetics

    #region TODO
    /*
    string twoPt = "Two-point perspective creates a sense of realism and dimension" +
      ", as all the parallel lines converge to two vanishing points on the horizon line.";
  //frog and bird
    string threePt = "Three - point perspective creates a sense of height and drama" +
      ", as all the parallel lines converge to three vanishing points, one on the horizon line and two above or below it.";

    string cameraAngles = "- Use different camera angles and positions, depending on the mood and message you want to convey." +
      "High - angle shots create a sense of overview and detachment, as the camera is placed above the eye level of the scene." +
      "Low - angle shots create a sense of dominance and importance, as the camera is placed below the eye level of the scene." +
      "Wide - angle shots create a sense of space and context, as the camera captures a large area of the scene." +
      "Close - up shots create a sense of detail and focus, as the camera zooms in on a specific part of the scene.";

    string colorSchemes = " - Use different color schemes and contrasts, depending on the style and theme you want to express." +
      "You can use complementary colors, which are opposite on the color wheel, to create a contrast and a dynamic effect." +
      "You can use analogous colors, which are adjacent on the color wheel, to create a harmony and a calm effect." +
      "You can use monochromatic colors, which are variations of the same hue, to create a unity and a simple effect." +
      "You can also use accents, which are small amounts of a different color, to create a highlight and a focal point.";
*/
    #endregion TODO</item>
